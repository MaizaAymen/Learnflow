# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local in your deployment
# Replace all values with actual credentials

# DATABASE (Render PostgreSQL)
DATABASE_URL=postgresql://username:password@your-db-host.render.com:5432/learnflow_db

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters

# Environment
NODE_ENV=production

# Frontend URL (Your Vercel frontend URL)
FRONTEND_URL=https://your-frontend.vercel.app

# ========================================
# SERVICE-SPECIFIC VARIABLES
# ========================================

# Auth Service
AUTH_SERVICE_PORT=3001
BCRYPT_ROUNDS=10

# Events Service
EVENTS_SERVICE_PORT=3002

# Messaging Service
MESSAGING_SERVICE_PORT=3003
SOCKET_IO_PORT=3003

# Notifications Service
NOTIFICATIONS_SERVICE_PORT=3004
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# ========================================
# OPTIONAL - Development Only
# ========================================
DEBUG=learnflow:*
LOG_LEVEL=info

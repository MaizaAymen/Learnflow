{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/learnflow/dist",
  "framework": "vite",
  "functions": {
    "api/auth/[...route].js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/events/[...route].js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/messaging/[...route].js": {
      "memory": 1024,
      "maxDuration": 30
    },
    "api/notifications/[...route].js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "FRONTEND_URL": "@frontend_url",
    "NODE_ENV": "production"
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth"
    },
    {
      "source": "/api/events/(.*)",
      "destination": "/api/events"
    },
    {
      "source": "/api/messaging/(.*)",
      "destination": "/api/messaging"
    },
    {
      "source": "/api/notifications/(.*)",
      "destination": "/api/notifications"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

# Frontend Environment Variables Example
# Copier ce fichier en .env ou .env.local et adapter les valeurs

# API Base URLs
REACT_APP_MESSAGING_URL=http://localhost:3001
REACT_APP_API_URL=http://localhost:3000
REACT_APP_AUTH_URL=http://localhost:8000

# WebSocket Configuration
REACT_APP_WEBSOCKET_RECONNECT_INTERVAL=1000
REACT_APP_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5

# Environment
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# Features
REACT_APP_ENABLE_MESSAGING=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_FILE_UPLOAD=false

# UI Configuration
REACT_APP_MESSAGES_PER_PAGE=30
REACT_APP_CONVERSATIONS_PER_PAGE=20
REACT_APP_TYPING_TIMEOUT=3000

# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and update with your actual URLs

# Main API URL (points to your Vercel backend)
VITE_API_URL=https://your-project.vercel.app/api

# Service-specific URLs (optional - use main API_URL)
VITE_AUTH_URL=https://your-project.vercel.app/api/auth
VITE_MESSAGING_URL=https://your-project.vercel.app/api/messaging
VITE_EVENTS_URL=https://your-project.vercel.app/api/events
VITE_NOTIFICATIONS_URL=https://your-project.vercel.app/api/notifications

# WebSocket Configuration (if using Socket.io)
VITE_WEBSOCKET_URL=https://your-project.vercel.app/api/messaging
VITE_WEBSOCKET_RECONNECT_INTERVAL=1000

# Environment
VITE_ENVIRONMENT=production
REACT_APP_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5

# Environment
REACT_APP_ENV=development
REACT_APP_DEBUG=true

# Features
REACT_APP_ENABLE_MESSAGING=true
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_FILE_UPLOAD=false

# UI Configuration
REACT_APP_MESSAGES_PER_PAGE=30
REACT_APP_CONVERSATIONS_PER_PAGE=20
REACT_APP_TYPING_TIMEOUT=3000
